#!/usr/bin/env bash
# Generic fake package manager. Logs its call; list commands print fixtures.
n=${0##*/}
printf '%s %s\n' "$n" "$*" >>"$PD_CALLS"
case "$n $1 $2" in
  "dpkg-query "*)   cat "$PD_STUB_DIR/apt.list" 2>/dev/null ;;
  "npm ls"*)        cat "$PD_STUB_DIR/node.list" 2>/dev/null ;;
  "npm config"*)    echo /nonexistent-prefix ;;
  "pipx list --json"*) cat "$PD_STUB_DIR/pipx.json" 2>/dev/null ;;
  "pipx list"*)     cat "$PD_STUB_DIR/pipx.list" 2>/dev/null ;;
  "cargo install --list"*) cat "$PD_STUB_DIR/cargo.list" 2>/dev/null ;;
  "gem list"*)      cat "$PD_STUB_DIR/gem.list" 2>/dev/null ;;
  "gem env"*)       echo "$PD_STUB_DIR/gemdir" ;;
  "go version"*)    cat "$PD_STUB_DIR/go.list" 2>/dev/null ;;
  "composer global show"*) cat "$PD_STUB_DIR/composer.list" 2>/dev/null ;;
esac
for v in ${PD_STUB_ENV:-}; do printf 'env %s=%s\n' "$v" "${!v-}" >>"$PD_CALLS"; done
# apt-get install can "provide" tools: PD_STUB_PROVIDES="pipx npm"
if [[ $n == apt-get && ${1:-} == install && -n ${PD_STUB_PROVIDES:-} ]]; then
  for v in $PD_STUB_PROVIDES; do ln -sf "$0" "$PD_STUB_DIR/bin/$v"; done
fi
if [[ $n == sudo ]]; then exec "$@"; fi
[[ ${PD_STUB_FAIL_FOR:-} == "$n" && $1 =~ ^(install|require)$ ]] && exit 1
exit 0
