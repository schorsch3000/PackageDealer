#!/usr/bin/env bash
# PackageDealer - install packages with apt, npm, pipx, composer, cargo, gem
# and go, fast.
#
# Speed strategy: never ask a package manager "is X installed?" per package.
# Fetch each manager's installed list once (in parallel), diff in memory,
# then install everything that is missing in ONE call per manager.
# Already installed packages are never touched, never upgraded.
#
# Built for container images: running as root installs system-wide, an empty
# apt index is refreshed automatically, --clean removes caches again.

PD_VERSION=0.1.0

# Install order matters: apt may provide the toolchains for the others.
PD_MANAGERS=(apt node pipx composer cargo gem go)

# shellcheck disable=SC2034  # used via namerefs
declare -a WANT_apt=() WANT_node=() WANT_pipx=() WANT_composer=() WANT_cargo=() WANT_gem=() WANT_go=()
declare -A PD_SEEN=()
PD_DRY_RUN=0
PD_CHECK=0
PD_CLEAN=0
PD_APT_UPDATE=0
PD_UPGRADE=0
PD_APT_NO_RECOMMENDS=0
PD_VERBOSE=0          # -1 quiet, 0 normal, 1 verbose
PD_STDIN_USED=0
PD_TMP=
PD_SOURCES=()         # "mode:file", mode = manager name or "mixed"
PD_PIPX_GLOBAL=()
PD_GEM_USER=()

shopt -s extglob

pd_usage() {
  cat <<'EOF'
Usage: PackageDealer [options]

Install packages globally; skip what is already installed.

Package sources (repeatable; FILE "-" reads stdin, once):
  -a, --apt FILE        apt packages, one per line
  -n, --node FILE       npm packages (npm install -g)
  -p, --pipx FILE       pipx packages
  -c, --composer FILE   composer packages (composer global require)
  -r, --cargo FILE      cargo crates (cargo install)
  -e, --gem FILE        ruby gems (gem install)
  -g, --go FILE         go packages (go install, @latest if no version)
  -f, --file FILE       prefixed lines: a:foo n:bar p:baz c:vendor/pkg
                        r:crate e:gem g:module/path (or apt: node: pipx:
                        composer: cargo: gem: go:)
  -D, --dir DIR         read every file in DIR: *.apt *.node *.pipx
                        *.composer *.cargo *.gem *.go (one per line),
                        *.txt (prefixed lines), sorted by name

Behaviour:
  -U, --upgrade         also upgrade the listed packages that are already
                        installed (implies --update). Pinned specs are not
                        upgraded. Without it nothing is ever upgraded.
  -u, --update          run apt-get update first (only if apt has work);
                        done automatically when the apt index is empty
  -R, --no-recommends   apt: --no-install-recommends
      --clean           remove package caches of installed managers afterwards
  -d, --dry-run         only print what would be installed
      --check           like --dry-run, but exit 1 if anything is missing
  -q, --quiet           only errors
  -v, --verbose         print the commands that are run
  -h, --help            show this help
  -V, --version         show version

If no "-" is given and stdin is not a terminal, "-f -" is assumed. Blank
lines, whitespace around names and everything after '#' are ignored.

As root everything is installed system-wide. Otherwise: apt uses sudo, npm
falls back to PD_NPM_PREFIX (default ~/.local) if its prefix is not writable,
gem uses --user-install.
EOF
}

pd_log()  { printf 'PackageDealer: %s\n' "$*" >&2; }
pd_info() { if ((PD_VERBOSE >= 0)); then pd_log "$@"; fi; }
pd_die()  { pd_log "error: $*"; exit 1; }
pd_is_root() { ((${PD_EUID:-$EUID} == 0)); }

# Run a command; show it with -v.
pd_run() {
  if ((PD_VERBOSE > 0)); then printf '+ %s\n' "$*" >&2; fi
  "$@"
}

# ---------------------------------------------------------------- parsing

# pd_prefix_to_manager PREFIX -> REPLY
pd_prefix_to_manager() {
  case $1 in
    a|apt) REPLY=apt ;;
    n|node|npm) REPLY=node ;;
    p|pipx) REPLY=pipx ;;
    c|composer) REPLY=composer ;;
    r|cargo) REPLY=cargo ;;
    e|gem) REPLY=gem ;;
    g|go) REPLY=go ;;
    *) return 1 ;;
  esac
}

pd_add_want() {
  local mgr=$1 spec=$2
  [[ -n ${PD_SEEN["$mgr|$spec"]:-} ]] && return 0
  PD_SEEN["$mgr|$spec"]=1
  local -n _list="WANT_$mgr"
  _list+=("$spec")
}

# pd_read_file MODE FILE   (MODE = manager name, or "mixed" for prefixed lines)
pd_read_file() {
  local mode=$1 file=$2 line mgr n=0
  if [[ $file == - ]]; then
    exec 3<&0
  else
    [[ -r $file ]] || pd_die "cannot read file: $file"
    exec 3<"$file"
  fi
  while IFS= read -r line <&3 || [[ -n $line ]]; do
    n=$((n + 1))
    line=${line%%#*}
    line=${line##+([[:space:]])}
    line=${line%%+([[:space:]])}
    [[ -z $line ]] && continue
    if [[ $mode == mixed ]]; then
      if [[ $line =~ ^([a-z]+):[[:space:]]*(.+)$ ]] \
        && pd_prefix_to_manager "${BASH_REMATCH[1]}"; then :; else
        pd_die "$file:$n: expected a manager prefix (a: n: p: c: r: e: g:), got '$line'"
      fi
      mgr=$REPLY
      line=${BASH_REMATCH[2]}
    else
      mgr=$mode
    fi
    pd_add_want "$mgr" "$line"
  done
  exec 3<&-
}

# pd_add_dir DIR: queue every recognised file in DIR
pd_add_dir() {
  local dir=$1 f ext
  [[ -d $dir ]] || pd_die "not a directory: $dir"
  for f in "$dir"/*; do
    [[ -f $f ]] || continue
    ext=${f##*.}
    case $ext in
      apt|pipx|composer|cargo|gem|go) PD_SOURCES+=("$ext:$f") ;;
      node|npm) PD_SOURCES+=("node:$f") ;;
      txt) PD_SOURCES+=("mixed:$f") ;;
    esac
  done
}

# ------------------------------------------------------------ name keys
# pd_key MANAGER SPEC -> sets REPLY to the name used to compare against the
# installed list (version pins etc. stripped). No forks: this runs per package.

pd_key() {
  local mgr=$1 s=$2 n
  case $mgr in
    apt)
      n=${s%%[=/]*}          # foo=1.2  foo/release
      REPLY=$n ;;            # foo:arch is kept, installed list has both forms
    node)
      if [[ $s == @* ]]; then n=${s:1}; REPLY=@${n%%@*}; else REPLY=${s%%@*}; fi ;;
    pipx)
      if [[ $s == *[/:]* ]]; then REPLY=$s; return 0; fi   # url/path: matched by exact spec
      n=${s%%[=<>~!\[\ @;]*}
      n=${n,,}
      REPLY=${n//+([-_.])/-} ;;
    composer)
      n=${s%%[:=^~\ ]*}
      REPLY=${n,,} ;;
    cargo)
      n=${s%%@*}
      n=${n,,}
      REPLY=${n//_/-} ;;
    gem)
      REPLY=$s ;;
    go)
      REPLY=${s%%@*} ;;
    *) return 1 ;;
  esac
}

# ------------------------------------------------------- installed lists
# Each prints one key per line, same normalisation as pd_key.

pd_list_apt() {
  # Also emits Provides: names, so virtual packages with an installed
  # provider count as present (apt would no-op on them anyway).
  dpkg-query -W -f='${db:Status-Abbrev} ${Package}:${Architecture} ${Provides}\n' \
    | awk '$1 == "ii" {
        split($2, a, ":"); print a[1]; print $2
        for (i = 3; i <= NF; i++) {
          gsub(/[,|]/, "", $i)
          if ($i ~ /^[a-z0-9][a-z0-9+.-]*$/) print $i
        }
      }'
}

pd_list_node() {
  # npm ls exits non-zero on a missing prefix dir or extraneous packages
  { npm ls -g --depth=0 --parseable 2>/dev/null || true; } \
    | awk -F'/node_modules/' 'NF > 1 { print $2 }'
}

pd_list_pipx() {
  pipx list --short "${PD_PIPX_GLOBAL[@]}" 2>/dev/null | while read -r name _; do
    [[ -n $name ]] || continue
    name=${name,,}
    printf '%s\n' "${name//+([-_.])/-}"
  done
  # URL/path specs have no knowable name; match them by the exact spec pipx
  # recorded. Extra call, only when such a spec was requested.
  local spec
  for spec in "${WANT_pipx[@]}"; do
    if [[ $spec == *[/:]* ]]; then
      pipx list --json "${PD_PIPX_GLOBAL[@]}" 2>/dev/null \
        | sed -n 's/^ *"package_or_url": *"\(.*\)",\{0,1\}$/\1/p'
      break
    fi
  done
}

pd_list_composer() {
  composer global show --direct --name-only --no-interaction 2>/dev/null \
    | awk 'NF { print tolower($1) }'
}

pd_list_cargo() {
  cargo install --list 2>/dev/null \
    | awk '/^[^[:space:]]/ { n = $1; sub(/:$/, "", n); gsub(/_/, "-", n); print tolower(n) }'
}

pd_list_gem() {
  gem list --local --no-versions 2>/dev/null \
    | awk 'NF == 1 && $1 !~ /^\*/ { print $1 }'
}

# go has no registry of installed tools: ask the binaries in the bin dir for
# the main package path they were built from (one `go version -m` call).
pd_go_bindir() {
  local p
  if [[ -n ${GOBIN:-} ]]; then
    REPLY=$GOBIN
  else
    p=${GOPATH:-$HOME/go}
    REPLY=${p%%:*}/bin
  fi
}

pd_list_go() {
  pd_go_bindir
  [[ -d $REPLY ]] || return 0
  { go version -m "$REPLY"/* 2>/dev/null || true; } \
    | awk -F'\t' '$2 == "path" { print $3 }'
}

# ------------------------------------------------------------- installing

pd_as_root() {
  if pd_is_root; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    pd_die "apt needs root and sudo is not available"
  fi
}

pd_apt_lists_dir() { REPLY=${PD_APT_LISTS:-/var/lib/apt/lists}; }

# Base images ship without an apt index; installs would fail without update.
pd_apt_lists_empty() {
  pd_apt_lists_dir
  ! compgen -G "$REPLY/*_Packages*" >/dev/null
}

pd_install_apt() {
  local apt=(env DEBIAN_FRONTEND=noninteractive apt-get)
  local opts=(-o Acquire::Retries=3)
  ((PD_VERBOSE < 0)) && opts+=(-q)
  if ((PD_APT_UPDATE)) || pd_apt_lists_empty; then
    pd_run pd_as_root "${apt[@]}" update "${opts[@]}" || return 1
  fi
  ((PD_APT_NO_RECOMMENDS)) && opts+=(--no-install-recommends)
  local flags=(-y)
  ((PD_UPGRADE)) || flags+=(--no-upgrade)
  pd_run pd_as_root "${apt[@]}" install "${flags[@]}" "${opts[@]}" "$@"
}

pd_install_node() {
  local q=()
  ((PD_VERBOSE < 0)) && q=(--loglevel=error)
  if ((PD_UPGRADE)); then
    local specs=() s
    for s in "$@"; do
      pd_key node "$s"
      if [[ $REPLY == "$s" ]]; then specs+=("$s@latest"); else specs+=("$s"); fi
    done
    set -- "${specs[@]}"
  fi
  pd_run npm install -g "${q[@]}" "$@"
}

pd_install_pipx() {
  local q=()
  ((PD_VERBOSE < 0)) && q=(--quiet)
  pd_run pipx install "${PD_PIPX_GLOBAL[@]}" "${q[@]}" "$@"
}

pd_install_composer() {
  local q=()
  ((PD_VERBOSE < 0)) && q=(-q)
  pd_run composer global require --no-interaction "${q[@]}" "$@"
}

pd_install_cargo() {
  local q=()
  ((PD_VERBOSE < 0)) && q=(-q)
  pd_run cargo install "${q[@]}" "$@"
}

pd_install_gem() {
  local q=()
  ((PD_VERBOSE < 0)) && q=(--quiet)
  pd_run gem install --no-document "${PD_GEM_USER[@]}" "${q[@]}" "$@"
}

# Managers whose install call also upgrades when asked (given all specs):
# apt (no --no-upgrade), node (@latest), cargo, go (@latest).
pd_upgrade_inline() {
  case $1 in apt|node|cargo|go) return 0 ;; *) return 1 ;; esac
}

# pd_upgrade_MANAGER installed-specs...  (only for the others)
pd_upgrade_pipx() {
  local q=() s names=()
  ((PD_VERBOSE < 0)) && q=(--quiet)
  for s in "$@"; do
    pd_key pipx "$s"
    if [[ $REPLY == "$s" && $s == *[/:]* ]]; then
      pd_log "warning: cannot upgrade url/path spec '$s'"
    elif [[ $REPLY == "$s" ]]; then
      names+=("$REPLY")      # unpinned
    fi                       # pinned: stays
  done
  ((${#names[@]})) || return 0
  pd_run pipx upgrade "${PD_PIPX_GLOBAL[@]}" "${q[@]}" "${names[@]}"
}

pd_upgrade_composer() {
  local q=() s names=()
  ((PD_VERBOSE < 0)) && q=(-q)
  for s in "$@"; do
    pd_key composer "$s"
    if [[ ${REPLY} == "${s,,}" ]]; then names+=("$REPLY"); fi   # pinned: stays
  done
  ((${#names[@]})) || return 0
  pd_run composer global update --no-interaction "${q[@]}" "${names[@]}"
}

pd_upgrade_gem() {
  local q=()
  ((PD_VERBOSE < 0)) && q=(--quiet)
  pd_run gem update "${PD_GEM_USER[@]}" "${q[@]}" "$@"
}

# go install needs a version and cannot mix modules reliably: one call each.
pd_install_go() {
  local p rc=0
  for p in "$@"; do
    [[ $p == *@* ]] || p+=@latest
    pd_run go install "$p" || rc=1
  done
  return $rc
}

# ---------------------------------------------------------------- cleaning

pd_clean_apt() {
  pd_apt_lists_dir
  pd_run pd_as_root apt-get clean
  pd_run pd_as_root rm -rf -- "$REPLY"/*
}
pd_clean_node()     { pd_run npm cache clean --force; }
pd_clean_pipx()     { pd_run rm -rf -- "${XDG_CACHE_HOME:-$HOME/.cache}/pip" "${XDG_CACHE_HOME:-$HOME/.cache}/pipx"; }
pd_clean_composer() { pd_run composer clear-cache --no-interaction; }
pd_clean_cargo() {
  local home=${CARGO_HOME:-$HOME/.cargo}
  pd_run rm -rf -- "$home/registry" "$home/git"
}
pd_clean_gem() {
  local dir
  dir=$(gem env gemdir 2>/dev/null) || return 0
  pd_run rm -rf -- "$dir/cache"
}
pd_clean_go() { pd_run go clean -cache -modcache; }

# ------------------------------------------------- per-manager environment
# Run in the main shell before the list calls, so list and install agree.

pd_tools_for() {
  case $1 in
    apt) REPLY="apt-get dpkg-query" ;;
    node) REPLY="npm" ;;
    *) REPLY=$1 ;;
  esac
}

# pd_missing_tool MANAGER: if one of its tools is missing, set REPLY to it, return 0
pd_missing_tool() {
  local tool
  pd_tools_for "$1"
  for tool in $REPLY; do
    if ! command -v "$tool" >/dev/null 2>&1; then REPLY=$tool; return 0; fi
  done
  return 1
}

# Non-root users usually cannot write npm's default global prefix.
pd_setup_node() {
  [[ -n ${NPM_CONFIG_PREFIX:-} ]] && return 0
  pd_is_root && return 0
  local prefix
  prefix=$(npm config get prefix 2>/dev/null) || return 0
  if [[ ! -w $prefix ]]; then
    export NPM_CONFIG_PREFIX=${PD_NPM_PREFIX:-$HOME/.local}
  fi
}

pd_setup_pipx() {
  if pd_is_root; then PD_PIPX_GLOBAL=(--global); fi
}

pd_setup_composer() {
  pd_is_root || return 0
  export COMPOSER_ALLOW_SUPERUSER=1
  export COMPOSER_HOME=${COMPOSER_HOME:-/usr/local/composer}
  export COMPOSER_BIN_DIR=${COMPOSER_BIN_DIR:-/usr/local/bin}
}

pd_setup_cargo() {
  if pd_is_root; then export CARGO_INSTALL_ROOT=${CARGO_INSTALL_ROOT:-/usr/local}; fi
}

pd_setup_gem() {
  pd_is_root || PD_GEM_USER=(--user-install)
}

pd_setup_go() {
  if pd_is_root; then export GOBIN=${GOBIN:-/usr/local/bin}; fi
}

# --------------------------------------------------------------- main flow

# pd_add_source MODE OPTION FILE...   (called with the remaining args)
pd_add_source() {
  local mode=$1 opt=$2
  [[ $# -ge 3 ]] || pd_die "$opt needs a file"
  if [[ $3 == - ]]; then
    ((PD_STDIN_USED)) && pd_die "stdin ('-') can only be used once"
    PD_STDIN_USED=1
  fi
  PD_SOURCES+=("$mode:$3")
}

pd_parse_args() {
  while (($#)); do
    case $1 in
      -a|--apt)      pd_add_source apt "$@"; shift 2 ;;
      -n|--node)     pd_add_source node "$@"; shift 2 ;;
      -p|--pipx)     pd_add_source pipx "$@"; shift 2 ;;
      -c|--composer) pd_add_source composer "$@"; shift 2 ;;
      -r|--cargo)    pd_add_source cargo "$@"; shift 2 ;;
      -e|--gem)      pd_add_source gem "$@"; shift 2 ;;
      -g|--go)       pd_add_source go "$@"; shift 2 ;;
      -f|--file)     pd_add_source mixed "$@"; shift 2 ;;
      -D|--dir)      [[ $# -ge 2 ]] || pd_die "$1 needs a directory"; pd_add_dir "$2"; shift 2 ;;
      -u|--update)   PD_APT_UPDATE=1; shift ;;
      -U|--upgrade)  PD_UPGRADE=1; PD_APT_UPDATE=1; shift ;;
      -R|--no-recommends) PD_APT_NO_RECOMMENDS=1; shift ;;
      --clean)       PD_CLEAN=1; shift ;;
      -d|--dry-run)  PD_DRY_RUN=1; shift ;;
      --check)       PD_DRY_RUN=1; PD_CHECK=1; shift ;;
      -q|--quiet)    PD_VERBOSE=-1; shift ;;
      -v|--verbose)  PD_VERBOSE=1; shift ;;
      -h|--help)     pd_usage; exit 0 ;;
      -V|--version)  echo "PackageDealer $PD_VERSION"; exit 0 ;;
      *)             pd_usage >&2; pd_die "unknown argument: $1" ;;
    esac
  done
  # Piped/redirected stdin and no explicit '-': read it as "-f -".
  if ((!PD_STDIN_USED)) && [[ ! -t 0 ]]; then
    PD_SOURCES+=("mixed:-")
  fi
  local src
  for src in "${PD_SOURCES[@]}"; do
    pd_read_file "${src%%:*}" "${src#*:}"
  done
}

# pd_compute_missing MANAGER MISSING_OUTVAR PRESENT_OUTVAR
pd_compute_missing() {
  local mgr=$1
  local -n _missing=$2
  local -n _present=$3
  local -n _want="WANT_$mgr"
  local -A have=()
  local key spec
  while IFS= read -r key; do have[$key]=1; done <"$PD_TMP/$mgr"
  _missing=()
  _present=()
  for spec in "${_want[@]}"; do
    pd_key "$mgr" "$spec"
    if [[ -n ${have[$REPLY]:-} ]]; then _present+=("$spec"); else _missing+=("$spec"); fi
  done
}

pd_main() {
  pd_parse_args "$@"

  local mgr active=()
  for mgr in "${PD_MANAGERS[@]}"; do
    local -n _w="WANT_$mgr"
    ((${#_w[@]})) && active+=("$mgr")
    unset -n _w
  done
  if ((${#active[@]} == 0)); then
    pd_info "nothing to do"
    return 0
  fi

  # Fail early, before anything is installed. Exception: if apt is part of
  # this run, a missing tool of another manager may be installed by apt
  # (e.g. pipx, npm, composer): that manager is deferred until apt is done.
  local -A deferred=()
  local with_apt=0 started=()
  [[ " ${active[*]} " == *" apt "* ]] && with_apt=1
  for mgr in "${active[@]}"; do
    if pd_missing_tool "$mgr"; then
      if ((with_apt)) && [[ $mgr != apt ]]; then
        deferred[$mgr]=1
      else
        pd_die "$mgr requested but '$REPLY' not found"
      fi
    else
      started+=("$mgr")
    fi
  done

  PD_TMP=$(mktemp -d)
  trap 'rm -rf "$PD_TMP"' EXIT

  for mgr in "${started[@]}"; do
    if declare -F "pd_setup_$mgr" >/dev/null; then "pd_setup_$mgr"; fi
  done

  # One list call per manager, all in parallel.
  local -A pids=()
  for mgr in "${started[@]}"; do
    "pd_list_$mgr" >"$PD_TMP/$mgr" 2>"$PD_TMP/$mgr.err" &
    pids[$mgr]=$!
  done
  local failed=0
  for mgr in "${started[@]}"; do
    wait "${pids[$mgr]}" || {
      pd_log "error: could not list installed $mgr packages: $(head -n1 "$PD_TMP/$mgr.err")"
      failed=1
    }
  done
  ((failed)) && return 1

  # Sequential installs, one batch per manager.
  local rc=0 missing present todo ups any_missing=0 attempted=()
  for mgr in "${active[@]}"; do
    if [[ -n ${deferred[$mgr]:-} ]]; then
      if ((PD_DRY_RUN)); then
        : >"$PD_TMP/$mgr"   # tool not installed yet: nothing of it is installed
      else
        if pd_missing_tool "$mgr"; then
          pd_log "error: $mgr: '$REPLY' still not found after installing apt packages"
          rc=1
          continue
        fi
        if declare -F "pd_setup_$mgr" >/dev/null; then "pd_setup_$mgr"; fi
        if ! "pd_list_$mgr" >"$PD_TMP/$mgr" 2>"$PD_TMP/$mgr.err"; then
          pd_log "error: could not list installed $mgr packages: $(head -n1 "$PD_TMP/$mgr.err")"
          rc=1
          continue
        fi
      fi
    fi
    pd_compute_missing "$mgr" missing present
    todo=("${missing[@]}")
    ups=()
    if ((PD_UPGRADE)); then
      local -n _w="WANT_$mgr"
      if pd_upgrade_inline "$mgr"; then todo=("${_w[@]}"); else ups=("${present[@]}"); fi
      unset -n _w
      pd_info "$mgr: ${#missing[@]} to install, ${#present[@]} to upgrade"
    else
      pd_info "$mgr: ${#missing[@]} to install, ${#present[@]} already present"
    fi
    ((${#missing[@]})) && any_missing=1
    if ((PD_DRY_RUN)); then
      ((${#missing[@]})) && printf '%s: %s\n' "$mgr" "${missing[*]}"
      if ((PD_UPGRADE && ${#present[@]})); then printf '%s upgrade: %s\n' "$mgr" "${present[*]}"; fi
      continue
    fi
    if ((${#todo[@]} + ${#ups[@]})); then attempted+=("$mgr"); fi
    if ((${#todo[@]})); then
      "pd_install_$mgr" "${todo[@]}" || { pd_log "error: $mgr install failed"; rc=1; }
    fi
    if ((${#ups[@]})); then
      "pd_upgrade_$mgr" "${ups[@]}" || { pd_log "error: $mgr upgrade failed"; rc=1; }
    fi
  done

  if ((PD_CHECK && any_missing)); then return 1; fi

  if ((PD_CLEAN)); then
    for mgr in "${attempted[@]}"; do
      "pd_clean_$mgr" || pd_log "warning: cleaning $mgr failed"
    done
  fi
  return $rc
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -euo pipefail
  pd_main "$@"
fi
